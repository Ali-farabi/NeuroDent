{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:postgres:check": "node --no-warnings backend/postgres/check.js",
    "db:postgres:local": "docker compose -f ../docker-compose.yml --profile postgres up -d postgres",
    "db:postgres:local:check": "node --no-warnings backend/postgres/check.js --local",
    "db:postgres:local:migrate": "node --no-warnings backend/postgres/migrate.js --local",
    "db:postgres:migrate": "node --no-warnings backend/postgres/migrate.js",
    "reset:dev-passwords": "node --no-warnings backend/reset-dev-passwords.js",
    "storage:supabase:check": "node --no-warnings backend/supabase-storage/check.js",
    "test:backend": "node --no-warnings backend/smoke-test.js",
    "test:e2e": "node --no-warnings backend/next-smoke-test.js",
    "test:postgres": "node --no-warnings backend/postgres/check.js --skip-if-missing"
  },
  "dependencies": {
    "@next/env": "16.2.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
